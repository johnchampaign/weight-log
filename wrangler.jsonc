{
  "name": "weight-log",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public"
  },
  "observability": {
    "enabled": true
  },
  // Password reset email sender (Resend). The API key is a secret:
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    "MAIL_FROM": "noreply@johnchampaign.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "weight-log",
      "database_id": "7ee11aa9-b816-407a-95eb-a907e1bedfcd"
    }
  ]
}
